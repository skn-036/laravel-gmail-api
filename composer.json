{
    "name": "skn036/laravel-gmail-api",
    "version": "1.1.0",
    "description": "Gmail API wrapper for Laravel",
    "keywords": [
        "laravel",
        "google",
        "oauth",
        "client",
        "api"
    ],
    "homepage": "https://github.com/skn036/laravel-gmail-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Muhammad Sajedul Karim",
            "email": "noman0703036@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Alex Stewart",
            "email": "iamalexstewart@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2||^8.3||^8.4",
        "illuminate/contracts": "^10||^11||^12.1.1",
        "skn036/laravel-google-client": "^1.1",
        "symfony/mailer": "^6||^7"
    },
    "require-dev": {
        "nunomaduro/collision": "^7.10.0||^8.1.1",
        "larastan/larastan": "^2.9||^3.0",
        "orchestra/testbench": "^8.22.0||^9.0.0||^10.0.0",
        "pestphp/pest": "^2.34||^3.0",
        "pestphp/pest-plugin-arch": "^2.7||^3.0",
        "pestphp/pest-plugin-laravel": "^2.3||^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.3||^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Skn036\\Gmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skn036\\Gmail\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-laravel-gmail-api --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Skn036\\Gmail\\GmailServiceProvider"
            ],
            "aliases": {
                "Gmail": "Skn036\\Gmail\\Facades\\Gmail"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
